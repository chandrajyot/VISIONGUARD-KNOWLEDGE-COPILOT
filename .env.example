# VisionGuard Knowledge Copilot Environment Configuration

# 1. Database & Persistence
DATABASE_URL=sqlite:///./visionguard.db
STORAGE_PATH=./storage

# 2. Vector DB & Embeddings
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=ms-marco-MiniLM-L-6-v2

# 3. LLM Provider (options: offline, openai, gemini, anthropic)
LLM_PROVIDER=offline
# LLM_API_KEY=your_llm_api_key_here

# 4. Security & CORS
JWT_SECRET=super-secret-visionguard-key-2026
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
